# JotForm API key (read-only access is enough). Never leaves this machine —
# it is only sent to api.jotform.com / www.jotform.com over HTTPS.
JOTFORM_API_KEY=

# --- Weekly digest email (optional; digest runs in dry-run mode without these) ---
# Use the campus SMTP relay or an app-specific password. Stays local.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="FollowUp <followup@example.org>"

# --- LLM issue extraction (optional) ---
# Google Gemini Flash free tier: create a key at https://aistudio.google.com/apikey
# With a key set, sync extracts issues via Gemini (notes are anonymized first —
# names/emails/phones never leave the machine); without one, or on any error,
# the built-in rule-based extractor is used. Test with: npm run llm:test
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- Dashboard (optional) ---
# Port for the local dashboard (default 4820)
FOLLOWUP_PORT=4820
# Base URL used in magic "check it off" links sent via WhatsApp/digest.
# On the laptop this defaults to http://localhost:4820 (links work on the
# laptop only); once on a Pi, set e.g. http://followup.local:4820 so links
# work from any phone on the campus network.
FOLLOWUP_BASE_URL=
# Secret for signing magic links. Leave empty — one is auto-generated and
# stored locally on first run. Set it only to share across installs.
FOLLOWUP_LINK_SECRET=
# Set a token to require ?token=... / cookie auth. Leave empty on a laptop
# (server only listens on 127.0.0.1). Set it when moving to a shared Pi.
FOLLOWUP_TOKEN=
